digraph overview {
 graph [rankdir=TB,bgcolor="#fbfcfe",pad=.35,nodesep=.45,ranksep=.65,compound=true,fontname="Noto Sans CJK SC",fontsize=25,label="01  总体架构｜两个独立产品与普通共享库",labelloc=t];
 node [shape=box,style="rounded,filled",fillcolor="#ffffff",color="#b6c4d5",fontname="Noto Sans CJK SC",fontsize=17,margin=".22,.15",width=3.6];
 edge [fontname="Noto Sans CJK SC",fontsize=13,color="#60768f",arrowsize=.8];
 subject [label="同一逻辑 SubjectId\n身份连续，资源与模型可更换",fillcolor="#f0e9ff",color="#805cba",URL="../../设计/基础设施/共同值与调用上下文.md"];
 subgraph cluster_nous {
  label="Nous Wave｜独立 TypeScript 服务";color="#5687c5";style=rounded;
  nous [label="认知与正式 API\nMaterial / 全部认知领域\nNousQL / Context / Growth",fillcolor="#eaf3fe",URL="../../设计/能力保全与现有代码纠偏.md"];
  nweb [label="apps/web · API · CLI · SDK\n独立登录与管理",fillcolor="#eef0fd",URL="../../设计/基础设施/管理呈现与扩展.md"];
  ndb [shape=cylinder,label="Nous PostgreSQL\n认知 / 来源 / 修订 / 时间\n本产品配置与实际调用",fillcolor="#eaf3fe",URL="../../设计/基础设施/存储事务与缓存.md"];
  nindex [label="Lance 可重建 Serving\n文档 FTS / dense\nRust 数值库（napi-rs）",fillcolor="#eaf3fe",URL="../../设计/基础设施/检索服务与认知消费者.md"];
  nweb -> nous [label="正式 owner 操作"];
  nous -> ndb [label="短事务"];
  nous -> nindex [label="检索与数值调用"];
 }
 subgraph cluster_hept {
  label="Heptalogos｜独立 TypeScript 服务";color="#cc8958";style=rounded;
  hept [label="生活、行为与正式 API\nWorld / Agency / Work\nMessage / Expression / Effect",fillcolor="#fff1e6",URL="../../设计/能力保全与现有代码纠偏.md"];
  hweb [label="apps/web · API · CLI · SDK\n独立登录，联合界面连正式 Client",fillcolor="#eef0fd",URL="../../设计/基础设施/管理呈现与扩展.md"];
  hdb [shape=cylinder,label="Hept PostgreSQL\n世界 / 消息 / 活动 / 效果\n本产品配置与实际调用",fillcolor="#fff1e6",URL="../../设计/基础设施/存储事务与缓存.md"];
  native [label="OpenClaw 原生 Task\ntools / subagent / history / Skills\n独立执行环境与私有过程",fillcolor="#f2f4f7",URL="../../设计/基础设施/模型供应与调用.md"];
  hweb -> hept [label="正式 owner 操作"];
  hept -> hdb [label="短事务"];
  hept -> native [label="专业任务与渠道 SDK"];
 }
 subject -> nous [label="长期认知"];
 subject -> hept [label="生活与选择"];
 hept -> nous [dir=both,label="正式 Client：认知 / 材料 / 实际消费\n来源政策 / clock.capture",color="#805cba",constraint=false];
 subgraph cluster_library {
  label="构建 / library dependency｜各产品各实例、各数据库";color="#52a587";style="rounded,dashed";
  platform [label="@nous-wave/platform/*\nbootstrap / settings / credentials\nnetwork / models / prompts\nstorage / operations / data\ntelemetry / time",fillcolor="#e8f6ef",URL="../../设计/整体架构与模块合同.md"];
  contracts [label="纯 contracts 与官方 Client\nRef / OriginIdentity / Policy\nConsumer / TimePoint / trace",fillcolor="#e8f6ef",URL="../../设计/基础设施/共同值与调用上下文.md"];
  ui [label="@nous-wave/management-ui\nVue / Vuetify 组件与 composables\n产品页面归各 apps/web",fillcolor="#eef0fd",URL="../../设计/基础设施/管理呈现与扩展.md"];
 }
 platform -> nous [style=dashed,color="#52a587",constraint=false];
 platform -> hept [style=dashed,color="#52a587",constraint=false];
 contracts -> nous [style=dashed,color="#52a587",constraint=false];
 contracts -> hept [style=dashed,color="#52a587",constraint=false];
 ui -> nweb [style=dashed,color="#8d9ace",constraint=false];
 ui -> hweb [style=dashed,color="#8d9ace",constraint=false];
 hept -> platform [style=invis]; nous -> platform [style=invis];
 models [label="AI SDK · 普通角色\n审议 / 表达 / 作者 / 形成\n实际调用、预算与结果保留",fillcolor="#f2f4f7",URL="../../设计/基础设施/模型供应与调用.md"];
 qq [label="默认 QQ：OneBot 源码改编\nxucheng/onebot + 旧 Hept 保真模块\nAstrBot：可选插件 / 管理参考",fillcolor="#f2f4f7",URL="../../设计/基础设施/媒体与材料基础.md"];
 platform -> models [style=dashed,label="直接采用 SDK"];
 native -> qq [label="原生 ChannelPlugin"];
 qq -> hept [label="完整收件与物理结果",constraint=false];
}
