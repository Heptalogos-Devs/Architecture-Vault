digraph flows {
 graph [rankdir=TB,bgcolor="#fbfcfe",pad=.35,nodesep=.45,ranksep=.6,fontname="Noto Sans CJK SC",fontsize=25,label="05  实际流｜材料、消费、形成与外部效果分别成立",labelloc=t];
 node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=16,margin=".2,.14",width=3.55,fillcolor="#ffffff",color="#b6c4d5"];
 edge [fontname="Noto Sans CJK SC",fontsize=12,color="#60768f",arrowsize=.8];
 incoming [label="真实收件 / 已实现世界事件\nraw、平台时间、媒体来源\n作者安排与 Subject 见闻分开",fillcolor="#fff1e6",color="#cc8958",URL="../../设计/基础设施/媒体与材料基础.md"];
 stored [label="Hept Message / Media / Event\n保全字节与固定修订\n通知先提供元信息",fillcolor="#fff1e6",color="#cc8958",URL="../../设计/基础设施/媒体与材料基础.md"];
 selected [label="Subject 选择打开与阅读\n绑定实际 ref / selector\n当前来源、Consumer 与听众核验",fillcolor="#fff1e6",color="#cc8958",URL="../../设计/基础设施/身份权限与密钥.md"];
 material [label="Nous Material / Context\n原件、选区、派生表示与来源\nquery / projection 按正式视图",fillcolor="#eaf3fe",color="#5687c5",URL="../../设计/基础设施/Prompt与上下文.md"];
 invocation [label="AI SDK / native 当次真实调用\n保留完整历史、工具与媒体输入\n真实 provider 派发 / 费用记录",fillcolor="#e8f6ef",color="#52a587",URL="../../设计/基础设施/模型供应与调用.md"];
 saved [label="原调用输出 / 用量先持久\n结果未知保留原 operation\n结构验证失败仍保留已付费事实",fillcolor="#e8f6ef",color="#52a587",URL="../../设计/基础设施/模型供应与调用.md"];
 encounter [label="Nous Encounter / 实际消费\n实际输入 portions、consumer\n观察 capture 与执行回执",fillcolor="#eaf3fe",color="#5687c5",URL="../../设计/基础设施/媒体与材料基础.md"];
 growth [label="后续 Growth / FormationArtifact\n有来源的认识候选与分组采用\n长期对象修订回到下一次上下文",fillcolor="#eaf3fe",color="#5687c5",URL="../../设计/能力保全与现有代码纠偏.md"];
 decision [label="Hept Decision → 领域采用\n更新 Activity / Pursuit / 计划\n或选择表达、委派、等待",fillcolor="#fff1e6",color="#cc8958",URL="../../设计/能力保全与现有代码纠偏.md"];
 expression [label="AI SDK 自然表达\n只用已采用意图与真实受众\n每次实际调用仍走同一消费链",fillcolor="#fff1e6",color="#cc8958",URL="../../设计/基础设施/模型供应与调用.md"];
 sender [label="OpenClaw SDK / OneBot sender\n每个实际 call 前重验当前授权\n不另建发送循环",fillcolor="#f2f4f7",color="#a4acba",URL="../../设计/基础设施/媒体与材料基础.md"];
 receipts [label="真实物理回执 → Hept 效果事实\n多个 call 对应实际表达段\n已接受 / 确未发出 / 待核实",fillcolor="#fff1e6",color="#cc8958",URL="../../设计/基础设施/媒体与材料基础.md"];
 task [label="按需原生 Task\n原生工具、历史与私有过程\n原 run 保存可继续的成果",fillcolor="#f2f4f7",color="#a4acba",URL="../../设计/基础设施/模型供应与调用.md"];
 published [label="可信宿主选定已保存结果\nmaterials.publish → publishedRef\nready 只建立待看机会",fillcolor="#fff1e6",color="#cc8958",URL="../../设计/基础设施/媒体与材料基础.md"];
 readclock [label="clock.read\n纯读当前投影\n查询 / 管理 / 日历 / 预览",fillcolor="#e8f6ef",color="#52a587",URL="../../设计/基础设施/时间与调度.md"];
 capture [label="clock.capture / captureIn\n源 authority 保存 high-water 与回执\n观察、形成分别取实际时点",fillcolor="#e8f6ef",color="#52a587",URL="../../设计/基础设施/时间与调度.md"];
 incoming -> stored -> selected -> material -> invocation -> saved;
 saved -> encounter [label="已实际消费的输入"];
 encounter -> growth [label="实际来源，非收件即形成"];
 saved -> decision [label="采用候选，程序执行"];
 decision -> expression -> sender -> receipts;
 decision -> task [label="专业委派"];
 task -> published [label="精确已保存区域"];
 published -> selected [label="以后显式查看",constraint=false];
 receipts -> stored [label="结果成为可接触事实",constraint=false];
 growth -> material [label="后续当前认知",constraint=false];
 capture -> invocation [label="实际 observed capture",style=dashed,constraint=false];
 capture -> saved [label="原 formed capture",style=dashed,constraint=false];
 readclock -> capture [style=invis];
 {rank=same;readclock;incoming;}
 {rank=same;capture;selected;}
}
