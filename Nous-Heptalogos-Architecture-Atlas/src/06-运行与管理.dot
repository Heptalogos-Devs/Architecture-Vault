digraph operations {
 graph [rankdir=TB,bgcolor="#fbfcfe",pad=.35,nodesep=.4,ranksep=.68,fontname="Noto Sans CJK SC",fontsize=25,label="06  运行与数据｜独立安装、权限、闭包与恢复",labelloc=t];
 node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=16,margin=".2,.14",width=3.55,color="#a4acba",fillcolor="#f2f4f7"];
 edge [fontname="Noto Sans CJK SC",fontsize=12,color="#60768f",arrowsize=.8];
 social [label="交往与 Subject 行为\n真实 chat 身份、生活优先指令\n不直接取得软件管理权限",fillcolor="#f0e9ff",color="#805cba",URL="../../设计/基础设施/身份权限与密钥.md"];
 system [label="确定性 System 管理\nAPI / CLI / Vue apps/web\n各自 Better Auth session / SDK",fillcolor="#eef0fd",color="#8d9ace",URL="../../设计/基础设施/管理呈现与扩展.md"];
 machine [label="Machine / 独立维护助手\nOS 服务、目录与运行时范围\n独立 Consumer / 工作空间 / 凭据",URL="../../设计/基础设施/身份权限与密钥.md"];
 recovery [label="本机有限 Recovery CLI\n主服务不可用时可运行\n认证修复、定位与备份恢复",URL="../../设计/基础设施/身份权限与密钥.md"];
 {rank=same;social;system;machine;recovery;}
 n [label="Nous 独立服务与生命周期\n自己的 API、定义、连接和状态",fillcolor="#eaf3fe",color="#5687c5",URL="../../设计/基础设施/安装与生命周期.md"];
 h [label="Hept 独立服务与生命周期\n自己的 API、主体与外部连接",fillcolor="#fff1e6",color="#cc8958",URL="../../设计/基础设施/安装与生命周期.md"];
 system -> n [label="正式用户 Client"];system -> h [label="正式用户 Client"];
 social -> h [label="交往消息 / 行为操作"];
 machine -> n [label="明确机器授权",style=dashed];machine -> h [style=dashed];
 recovery -> n [label="受限恢复",style=dashed];recovery -> h [style=dashed];
 ndb [shape=cylinder,label="Nous PostgreSQL\nMaterial / 领域 / 修订 / 时间\n调用与本产品 DBOS checkpoint",fillcolor="#eaf3fe",color="#5687c5",URL="../../设计/基础设施/安装与生命周期.md"];
 hdb [shape=cylinder,label="Hept PostgreSQL\nWorldClock / Message / Work\nDecision / 效果与本产品 checkpoint",fillcolor="#fff1e6",color="#cc8958",URL="../../设计/基础设施/安装与生命周期.md"];
 blobs [label="各产品 Blob 与固定表示\n原件、选区、producer、source DAG\n持有与清除各归实际 owner",fillcolor="#e8f6ef",color="#52a587",URL="../../设计/基础设施/媒体与材料基础.md"];
 lance [label="可重建 Serving 与数值资产\nLance FTS/dense、索引/配置版本\nRust 内部资产不是业务权威",fillcolor="#eaf3fe",color="#5687c5",URL="../../设计/基础设施/检索服务与认知消费者.md"];
 native [label="OpenClaw 原生私有数据\nTask / history / Skills / receipts\nSDK 导出、核实与清除",URL="../../设计/基础设施/媒体与材料基础.md"];
 n -> ndb;h -> hdb;n -> blobs;h -> blobs;n -> lance;h -> native;
 lifecycle [label="三种独立生命周期\nSubject Bundle / 安装备份 / 产品更新\n版本、引用与实际范围可查",fillcolor="#e8f6ef",color="#52a587",URL="../../设计/基础设施/数据生命周期与发行.md"];
 closure [label="引用闭包与恢复高水位\n源、派生、capture/segment、原成果\naccepted/unknown 保持原事实",fillcolor="#e8f6ef",color="#52a587",URL="../../设计/基础设施/时间与调度.md"];
 secrets [label="安装秘密独立配置\nSecretRef / OS、env、protected file\n服务委派、轮换、即时撤权",fillcolor="#e8f6ef",color="#52a587",URL="../../设计/基础设施/身份权限与密钥.md"];
 observe [label="Pino / OpenTelemetry / 状态\ntrace 关联调用、任务与物理效果\n费用 unknown 与资源压力如实显示",fillcolor="#e8f6ef",color="#52a587",URL="../../设计/基础设施/观测错误与诊断.md"];
 ndb -> lifecycle;hdb -> lifecycle;blobs -> lifecycle;native -> lifecycle;
 lifecycle -> closure [label="owner 参与闭包"];
 lifecycle -> secrets [label="操作配置分开"];
 closure -> observe [label="实际完成 / pending"];
 backup [label="成熟运维机制\npg_dump / restic / 原生 OS 服务\n显式取得 runtime，离线可维护",URL="../../设计/基础设施/安装与生命周期.md"];
 lifecycle -> backup [label="直接使用成熟工具"];
 lance -> backup [label="可选择重建",style=dashed,constraint=false];
}
